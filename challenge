#!/bin/sh
# @file challenge
# @description Runs the isolated local challenge CLI from the repository root.
# @depends_on challenge-cli/go.mod, challenge-cli/cmd/challenge/main.go
# @depended_on_by none

set -eu

project_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
go_cache="$project_root/.local/go-build"
go_module_cache="$project_root/.local/go-mod"

mkdir -p "$go_cache" "$go_module_cache"
cd "$project_root/challenge-cli"

GOCACHE="${GOCACHE:-$go_cache}"
GOMODCACHE="${GOMODCACHE:-$go_module_cache}"
TOKENIZER_PROJECT_ROOT="$project_root"
export GOCACHE GOMODCACHE TOKENIZER_PROJECT_ROOT

exec go run ./cmd/challenge "$@"

