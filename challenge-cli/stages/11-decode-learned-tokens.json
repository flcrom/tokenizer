{
  "version": 1,
  "stage": 11,
  "slug": "decode-learned-tokens",
  "title": "Decode learned tokens",
  "cases": [
    {
      "name": "decodes hierarchical banana tokens",
      "args": ["decode", "--model", "model.json", "--ids", "[257,258,33]"],
      "files": [
        {"path": "model.json", "content": {"text": "{\"version\":1,\"base_vocab_size\":256,\"merges\":[[97,110],[98,256],[256,97]]}"}}
      ],
      "expect": {
        "stdout": {"mode": "exact_text", "text": "banana!"},
        "stderr": {"mode": "empty"},
        "exit_code": 0
      }
    },
    {
      "name": "mixes base and learned token IDs",
      "args": ["decode", "--model", "model.json", "--ids", "[257,97,32,258]"],
      "files": [
        {"path": "model.json", "content": {"text": "{\"version\":1,\"base_vocab_size\":256,\"merges\":[[97,110],[98,256],[256,97]]}"}}
      ],
      "expect": {
        "stdout": {"mode": "exact_text", "text": "bana ana"},
        "stderr": {"mode": "empty"},
        "exit_code": 0
      }
    },
    {
      "name": "concatenates bytes before interpreting UTF-8",
      "args": ["decode", "--model", "model.json", "--ids", "[195,256,169]"],
      "files": [
        {"path": "model.json", "content": {"text": "{\"version\":1,\"base_vocab_size\":256,\"merges\":[[169,195]]}"}}
      ],
      "expect": {
        "stdout": {"mode": "exact_bytes", "base64": "w6nDqQ=="},
        "stderr": {"mode": "empty"},
        "exit_code": 0
      }
    },
    {
      "name": "writes an invalid UTF-8 learned token as raw bytes",
      "args": ["decode", "--model", "model.json", "--ids", "[256]"],
      "files": [
        {"path": "model.json", "content": {"text": "{\"version\":1,\"base_vocab_size\":256,\"merges\":[[169,195]]}"}}
      ],
      "expect": {
        "stdout": {"mode": "exact_bytes", "base64": "qcM="},
        "stderr": {"mode": "empty"},
        "exit_code": 0
      }
    },
    {
      "name": "decodes tokens learned from multibyte text",
      "args": ["decode", "--model", "model.json", "--ids", "[256,256]"],
      "files": [
        {"path": "model.json", "content": {"text": "{\"version\":1,\"base_vocab_size\":256,\"merges\":[[195,169]]}"}}
      ],
      "expect": {
        "stdout": {"mode": "exact_bytes", "base64": "w6nDqQ=="},
        "stderr": {"mode": "empty"},
        "exit_code": 0
      }
    },
    {
      "name": "preserves unseen multilingual base bytes",
      "args": ["decode", "--model", "model.json", "--ids", "[240,159,153,130,224,164,168]"],
      "files": [
        {"path": "model.json", "content": {"text": "{\"version\":1,\"base_vocab_size\":256,\"merges\":[[97,110],[98,256],[256,97]]}"}}
      ],
      "expect": {
        "stdout": {"mode": "exact_text", "text": "🙂न"},
        "stderr": {"mode": "empty"},
        "exit_code": 0
      }
    }
  ]
}
